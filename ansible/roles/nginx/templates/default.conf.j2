# Managed by Ansible — Scopify edge reverse proxy (nginx Docker image)
# Mounted at /etc/nginx/conf.d/default.conf
# HTTP :80  — ACME challenges + redirect to HTTPS (when certs exist)
# HTTPS :443 — reverse proxy to private Jenkins / Sonar / Nexus

{% raw %}
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
{% endraw %}

# ─── Default (unknown Host) ───────────────────────────────────────────────────
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 200 'Scopify edge (Docker nginx) — use jenkins/sonar/nexus.{{ edge_domain }}\n';
        add_header Content-Type text/plain;
    }
}

{% if nginx_tls_ready | default(false) %}
# ─── Default HTTPS catch-all ──────────────────────────────────────────────────
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;

    ssl_certificate     {{ nginx_ssl_cert_path }};
    ssl_certificate_key {{ nginx_ssl_key_path }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    location / {
        return 200 'Scopify edge (Docker nginx) — use jenkins/sonar/nexus.{{ edge_domain }}\n';
        add_header Content-Type text/plain;
    }
}
{% endif %}

# ─── Jenkins ──────────────────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name {{ jenkins_hostname }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
{% if nginx_tls_ready | default(false) %}
        return 301 https://$host$request_uri;
{% else %}
        client_max_body_size 100m;
        proxy_pass http://{{ jenkins_upstream }}:{{ jenkins_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 300;
{% endif %}
    }
}

{% if nginx_tls_ready | default(false) %}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ jenkins_hostname }};

    ssl_certificate     {{ nginx_ssl_cert_path }};
    ssl_certificate_key {{ nginx_ssl_key_path }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 100m;

    location / {
        proxy_pass http://{{ jenkins_upstream }}:{{ jenkins_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 300;
    }
}
{% endif %}

