# ─── K8s Ingress NodePort (both workers) ──────────────────────────────────────
# Flow: Internet → Cloudflare → NGINX EC2 → upstream k8s_ingress → Ingress
upstream k8s_ingress {
{% for ip in k8s_ingress_servers %}
    server {{ ip }}:{{ k8s_ingress_nodeport }};
{% endfor %}
}

# ─── K8s demo Ingress (dev) ───────────────────────────────────────────────────
