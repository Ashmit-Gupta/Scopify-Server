# Used by: kubectl create secret generic scopify-api-env --from-env-file=...
# Maps to Scopify Backend .env.prod / .env.dev (values differ per environment)

NODE_ENV=production
PORT=3000

# Host must match K8s Service name "postgres" in the same namespace
DATABASE_URL=postgresql://scopify:replace-with-strong-password@postgres:5432/scopify_db

JWT_SECRET=replace-with-long-random-secret

REDIS_HOST=redis
REDIS_PORT=6379

RESEND_API_KEY=re_replace_me
RESEND_FROM=Scopify <noreply@ashmit.xyz>
FRONTEND_URL=https://app.ashmit.xyz
