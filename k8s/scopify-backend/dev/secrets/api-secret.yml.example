# Copy to api-secret.yml, replace CHANGE_ME_*, then kubectl apply.
# DATABASE_URL password MUST match POSTGRES_PASSWORD in postgres-secret.yml
# Host "postgres" = K8s Service name in this namespace (do not use localhost)
apiVersion: v1
kind: Secret
metadata:
  name: scopify-api-env
  namespace: scopify-dev
  labels:
    app: scopify-api
    environment: dev
type: Opaque
stringData:
  NODE_ENV: development
  PORT: "3000"
  DATABASE_URL: postgresql://scopify:CHANGE_ME_PASSWORD@postgres:5432/scopify_db
  JWT_SECRET: CHANGE_ME_JWT_SECRET
  REDIS_HOST: redis
  REDIS_PORT: "6379"
  RESEND_API_KEY: CHANGE_ME_RESEND_API_KEY
  RESEND_FROM: Scopify <noreply@ashmit.xyz>
  FRONTEND_URL: https://app.ashmit.xyz
