# Copy to postgres-secret.yml, replace CHANGE_ME_*, then kubectl apply.
# Password MUST match the password inside DATABASE_URL in api-secret.yml
apiVersion: v1
kind: Secret
metadata:
  name: scopify-postgres
  namespace: scopify-prod
  labels:
    app: postgres
    environment: prod
type: Opaque
stringData:
  POSTGRES_USER: scopify
  POSTGRES_PASSWORD: CHANGE_ME_PASSWORD
  POSTGRES_DB: scopify_db
